// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  description String
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  skills     Skill[]
  experience Experience[]
  projects   Project[]

  @@map("profiles")
}

model Skill {
  id        String  @id @default(uuid())
  name      String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@map("skills")
}

model Experience {
  id           String    @id @default(uuid())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  achievements String[]
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experience")
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?
  url         String
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}
